# yajuter on Vercel + Supabase — copy to .env.local (gitignored)
# Supabase Dashboard → Project Settings → API

# Public (browser + build)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only (API Routes / getServerSideProps). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Single-user gate (Middleware password). Set a strong value in Vercel env.
YAJUTER_GATE_PASSWORD=change-me
