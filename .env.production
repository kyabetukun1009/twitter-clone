# Preview URL
NEXT_PUBLIC_URL=https://$NEXT_PUBLIC_VERCEL_URL

# Dummy Firebase placeholders so `next build` can import legacy modules.
# The app no longer uses Firebase (Supabase instead); real Firebase pages
# are being replaced route by route. NEVER put real keys here.
NEXT_PUBLIC_API_KEY=placeholder
NEXT_PUBLIC_AUTH_DOMAIN=placeholder
NEXT_PUBLIC_PROJECT_ID=placeholder
NEXT_PUBLIC_STORAGE_BUCKET=placeholder
NEXT_PUBLIC_MESSAGING_SENDER_ID=placeholder
NEXT_PUBLIC_APP_ID=placeholder
NEXT_PUBLIC_MEASUREMENT_ID=placeholder
NEXT_PUBLIC_USE_EMULATOR=false
